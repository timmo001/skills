{
  "name": "skill-maintenance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile dist/skill-maintenance",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "pretest": "bun run build",
    "test": "vitest run",
    "format": "prettier --write \"{src,tests}/**/*.ts\" oxlint.config.ts vitest.config.ts package.json tsconfig.json",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\" oxlint.config.ts vitest.config.ts package.json tsconfig.json",
    "catalogue": "bun run build && ./dist/skill-maintenance catalogue",
    "validate": "bun run lint && bun run typecheck && bun run test && bun run format:check && bun run build && ./dist/skill-maintenance validate",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@timmo001/effect-gh": "github:timmo001/effect-gh#0790a62934f0c9f234ddf0e7240648689ca99835",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.117",
    "@oxlint/plugins": "1.85.0",
    "@timmo001/oxlint-rules": "0.3.6",
    "@types/bun": "1.4.2",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
