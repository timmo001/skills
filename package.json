{
  "name": "skill-maintenance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile dist/skill-maintenance",
    "lint": "oxlint",
    "lint:yaml": "yamllint .",
    "typecheck": "tsc --noEmit && bun install --cwd opencode-plugin --frozen-lockfile && tsc -p opencode-plugin",
    "pretest": "bun run build",
    "test": "vitest run",
    "format": "prettier --write \"{src,tests,opencode-plugin/src}/**/*.ts\" \"**/*.md\" oxlint.config.ts vitest.config.ts package.json tsconfig.json",
    "format:check": "prettier --check \"{src,tests,opencode-plugin/src}/**/*.ts\" \"**/*.md\" oxlint.config.ts vitest.config.ts package.json tsconfig.json",
    "catalogue": "bun run build && ./dist/skill-maintenance catalogue",
    "validate": "bun run lint && bun run lint:yaml && bun run typecheck && bun run test && bun run format:check && bun run build && ./dist/skill-maintenance validate",
    "prepare": "effect-tsgo patch --force=false"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@timmo001/effect-gh": "0.12.0",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.4",
    "@effect/vitest": "4.1.2",
    "@oxlint/plugins": "1.92.0",
    "@timmo001/oxlint-rules": "0.6.4",
    "@types/bun": "1.4.4",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
